# Apex Motors Dealership Inventory System - Environment Configuration
# Copy this file to .env and adjust values as needed for your environment.

# Backend Configuration
PROJECT_NAME="Apex Motors Car Dealership Inventory API"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./dealership.db"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api"
